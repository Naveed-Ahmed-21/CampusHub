# ==========================================
# CampusHub Production Environment Configuration
# ==========================================

# Server Node Environment & Port
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 17)
POSTGRES_USER=campushub_admin
POSTGRES_PASSWORD=STRONG_PRODUCTION_DB_PASSWORD_CHANGE_ME
POSTGRES_DB=campushub_prod
POSTGRES_PORT=5432
DATABASE_URL=postgresql://campushub_admin:STRONG_PRODUCTION_DB_PASSWORD_CHANGE_ME@postgres:5432/campushub_prod?schema=public

# Redis In-Memory Cache & Pub/Sub
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Cryptographic JWT Secret Keys (Must be 32+ char random strings)
JWT_ACCESS_SECRET=PRODUCTION_JWT_ACCESS_SECRET_KEY_MUST_BE_SECURE_RANDOM_STRING_32_CHARS
JWT_REFRESH_SECRET=PRODUCTION_JWT_REFRESH_SECRET_KEY_MUST_BE_SECURE_RANDOM_STRING_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Domain Configuration
CORS_ORIGIN=https://campushub.edu,https://admin.campushub.edu

# Firebase Cloud Messaging (FCM) Credentials
FIREBASE_PROJECT_ID=campushub-4f0e5
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@campushub-4f0e5.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPRODUCTION_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Monitoring & Grafana Credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=SECURE_GRAFANA_ADMIN_PASSWORD
