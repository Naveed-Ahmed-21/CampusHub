# ==========================================
# CampusHub Environment Variables Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campushub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campushub?schema=public

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=campushub_jwt_access_secret_key_change_me_in_production_32chars
JWT_REFRESH_SECRET=campushub_jwt_refresh_secret_key_change_me_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mobile App API Configuration
FLUTTER_APP_API_BASE_URL=http://localhost:5000/api/v1
FLUTTER_APP_SOCKET_URL=http://localhost:5000
